@model RaceDay.Web.Models.OrganiserResultViewModel

<h2>Capture Result</h2>

<form>

    <div class="mb-3">
        <label>Position</label>
        <input asp-for="Position"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Finish Time</label>
        <input asp-for="FinishTime"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Bib Number</label>
        <input asp-for="BibNumber"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Save Result
    </button>

</form>