@model RaceDay.Web.Models.DashboardViewModel

<h2>Organiser Dashboard</h2>

<div class="row">

    <div class="col-md-4">

        <div class="card p-3">

            <h4>Total Events</h4>

            <h2>@Model.TotalEvents</h2>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card p-3">

            <h4>Total Enrolments</h4>

            <h2>@Model.TotalEnrolments</h2>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card p-3">

            <h4>Upcoming Events</h4>

            <h2>@Model.UpcomingEvents</h2>

        </div>

    </div>

</div>