@model List<RaceDay.Web.Models.OrganiserEventViewModel>

<h2>My Events</h2>

<p>
    
    <a asp-action="Create"
       class="btn btn-primary">
        Create New Event
    </a>
</p>

<table class="table table-striped">

    <thead>

        <tr>

            <th>Name</th>

            <th>Date</th>

            <th>Location</th>

            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.EventName</td>

                <td>@item.EventDate.ToShortDateString()</td>

                <td>@item.Location</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.EventId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.EventId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
